# Required
BOT_TOKEN=

# Optional — defaults to the bundled mongo/redis containers from docker-compose.yml.
# Only set these if you want to point at an external MongoDB Atlas / Redis Cloud instead.
DB_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Optional — only needed for uploads over Telegram's 50MB cloud-API cap.
# Get these from https://my.telegram.org/apps, then run:
#   docker compose --profile local-api up -d
# and set TELEGRAM_API_ROOT to the local-api container below.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_ROOT=
TELEGRAM_MAX_UPLOAD_MB=
